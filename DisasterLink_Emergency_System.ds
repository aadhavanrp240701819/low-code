				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have linked_incident
			(
				type = picklist	
				displayname = "Linked Incident"
				values  = disaster_incident.ID
    			displayformat = [incident_reference]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have assignment_status
			(
				type = picklist
				displayname = "Assignment Status"
				values = {"Assigned","Delivered","Failed","Closed","In Progress"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Allocated_Inventory_Item
			(
				type = picklist	
				displayname = "Allocated Inventory Item"
				values  = relief_inventory.ID
    			displayformat = [item_name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Quantity_Allocated
			(
				type = number
				displayname = "Quantity Allocated"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
