		workflow
		{
		form
		{
			auto_assign_critical_incident as "Auto-Assign Critical Incident"
			{
				type =  form
				form = disaster_incident

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if severity_level is Critical
										if(input.severity_level == "Critical")
										{
											// Set incident_status to Active
											input.incident_status = "Active";
										}
						)
					}
				}

			}
			low_stock_alert_notification as "Low Stock Alert Notification"
			{
				type =  form
				form = relief_inventory

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if available quantity is below minimum stock level
										if(input.available_quantity < input.minimum_stock_level)
										{
											// Prepare notification message
											itemName = input.item_name;
											currentStock = input.available_quantity.toString();
											minStock = input.minimum_stock_level.toString();
											warehouse = input.warehouse_name;
											message = "<p>Dear Manager,</p>";
											message = message.concat("<p>Alert: Inventory stock for <b>").concat(itemName).concat("</b> has dropped below minimum level.</p>");
											message = message.concat("<p>Current Stock: ").concat(currentStock).concat(" | Minimum Required: ").concat(minStock).concat("</p>");
											message = message.concat("<p>Warehouse: ").concat(warehouse).concat("</p>");
											message = message.concat("<p>Please take necessary action to replenish stock.</p>");
											// Send notification email to admin user
											sendmail
											[
												from :zoho.adminuserid
												to :zoho.adminuserid
												subject :"Inventory Alert: Stock Below Minimum Level"
												message :message
												content type :HTML
											]
										}
						)
					}
				}

			}
			Validate_Inventory_Alloca as "Validate Inventory Allocation"
			{
				type =  form
				form = response_assignment

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Allocated_Inventory_Item != null)
										{
											if(input.Quantity_Allocated == null || input.Quantity_Allocated <= 0)
											{
												alert "Enter a quantity greater than zero.";
												cancel submit;
											}
											inventoryRec = relief_inventory[ID == input.Allocated_Inventory_Item];
											if(inventoryRec.count() == 0)
											{
												alert "Selected inventory item was not found.";
												cancel submit;
											}
											else
											{
												availableQty = ifnull(inventoryRec.available_quantity,0);
												if(input.Quantity_Allocated > availableQty)
												{
													alert "Insufficient stock. Available quantity: " + availableQty.toString();
													cancel submit;
												}
											}
										}
										else if(input.Quantity_Allocated != null && input.Quantity_Allocated > 0)
										{
											alert "Select an inventory item before entering a quantity.";
											cancel submit;
										}
						)
					}
				}

			}
			Update_Inventory_Stock as "Update Inventory Stock"
			{
				type =  form
				form = response_assignment

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Allocated_Inventory_Item != null && input.Quantity_Allocated > 0)
										{
											inventoryRec = relief_inventory[ID == input.Allocated_Inventory_Item];
											if(inventoryRec.count() > 0)
											{
												inventoryRec.available_quantity=ifnull(inventoryRec.available_quantity,0) - input.Quantity_Allocated;
												inventoryRec.reserved_quantity=ifnull(inventoryRec.reserved_quantity,0) + input.Quantity_Allocated;
											}
										}
						)
					}
				}

			}
			Update_Linked_Request_Sta as "Update Linked Request Status"
			{
				type =  form
				form = response_assignment

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.linked_request != null)
										{
											requestRec = emergency_request[ID == input.linked_request];
											if(requestRec.count() > 0)
											{
												requestRec.request_status="Assigned";
											}
										}
						)
					}
				}

			}
		}

		schedule
		{
			daily_critical_incident_report as "Daily Critical Incident Report"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch all critical and high severity incidents
										incidents = disaster_incident[severity_level == "Critical" || severity_level == "High"];
										// Check if any incidents exist
										if(incidents.count() > 0)
										{
											// Initialize email message
											emailMessage = "<h2>Daily Incident Summary</h2>";
											emailMessage = emailMessage.concat("<p>The following critical and high severity incidents were reported today:</p>");
											emailMessage = emailMessage.concat("<ul>");
											// Iterate through each incident to build the message
											for each  incident in incidents
											{
												incidentReference = incident.incident_reference;
												incidentType = incident.disaster_type;
												severity = incident.severity_level;
												location = incident.location.address_line_1;
												affectedPopulation = incident.affected_population;
												incidentDate = incident.incident_date;
												emailMessage = emailMessage.concat("<li>");
												emailMessage = emailMessage.concat("<strong>Reference:</strong> " + incidentReference + " | ");
												emailMessage = emailMessage.concat("<strong>Type:</strong> " + incidentType + " | ");
												emailMessage = emailMessage.concat("<strong>Severity:</strong> " + severity + " | ");
												emailMessage = emailMessage.concat("<strong>Location:</strong> " + location + " | ");
												emailMessage = emailMessage.concat("<strong>Affected Population:</strong> " + affectedPopulation.toString() + " | ");
												emailMessage = emailMessage.concat("<strong>Date:</strong> " + incidentDate.toString());
												emailMessage = emailMessage.concat("</li>");
											}
											emailMessage = emailMessage.concat("</ul>");
											// Send the email
											sendmail
											[
												from :zoho.loginuserid
												to :zoho.loginuserid
												subject :"Daily Summary: Critical and High Severity Incidents"
												message :emailMessage
												content type :HTML
											]
										}
					)
					}
				}
			}
		}


