				width = medium
			)
			request_type
			(
				type = picklist
				displayname = "Request Type"
				values = {"Water","Shelter","Medical","Food","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			priority_level
			(
				type = picklist
				displayname = "Priority Level"
				values = {"High","Low","Medium","Critical"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			lives_at_risk
			(
				type = number
				displayname = "Lives At Risk"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			medical_assistance_needed
			(
    			type = checkbox
				displayname = "Medical Assistance Needed"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			description
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			linked_incident
			(
				type = picklist	
				displayname = "Linked Incident"
				values  = disaster_incident.ID
    			displayformat = [incident_reference]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			request_status
			(
				type = picklist
				displayname = "Request Status"
				values = {"Assigned","Submitted","Verified","Delivered","Closed","Approved","Rejected"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Request Received","Initial Triage","Request Rejected","Urgent Assessment","Standard Assessment","Responder Assignment","Resource Mobilization","Request Pending Review","Response En Route","On Scene","Assistance Provided","Request Closed"}
			}
		}
