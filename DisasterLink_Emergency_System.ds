 application "DisasterLink Emergency System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form disaster_incident
		{
			displayname = "Disaster Incident"
			success message = "Disaster Incident Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			incident_reference
			(
    			type = text
				displayname = "Incident Reference"
	 			row = 1
	 			column = 1   
				width = medium
			)
			incident_date
			(
    			type = date
				displayname = "Incident Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			location
			(
    			type = address
				displayname = "Location"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			disaster_type
			(
				type = picklist
				displayname = "Disaster Type"
				values = {"Storm","Flood","Earthquake","Fire","Landslide","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			affected_population
			(
				type = number
				displayname = "Affected Population"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			severity_level
			(
				type = picklist
				displayname = "Severity Level"
				values = {"High","Low","Medium","Critical"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			reporter_name
			(
    			type = name
				displayname = "Reporter Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			reporter_phone
			(
    			type = phonenumber
				displayname = "Reporter Phone"
	 			row = 1
	 			column = 1   
				width = medium
			)
			incident_status
			(
				type = picklist
				displayname = "Incident Status"
				values = {"Verified","Active","Reported","Closed"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
